# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{
  config,
  lib,
  pkgs,
  modulesPath,
  ...
}:

{
  imports = [ ];

  boot.initrd.availableKernelModules = [
    "ehci_pci"
    "ahci"
    "xhci_pci"
    "nvme"
    "usbhid"
    "sr_mod"
  ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ ];
  boot.extraModulePackages = [ ];

  # virtualization
  virtualisation.vmware.guest.enable = true;

  fileSystems."/" = {
    device = "/dev/mapper/luks-3d2072b6-dded-4392-ac3e-f3fec833fbf8";
    fsType = "ext4";
  };

  boot.initrd.luks.devices."luks-3d2072b6-dded-4392-ac3e-f3fec833fbf8".device =
    "/dev/disk/by-uuid/3d2072b6-dded-4392-ac3e-f3fec833fbf8";

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/B8AD-F923";
    fsType = "vfat";
    options = [
      "fmask=0077"
      "dmask=0077"
    ];
  };

  swapDevices = [
    { device = "/dev/mapper/luks-19e72072-914f-45f8-a900-269c39889a6a"; }
  ];

  # Not auto-detected by the hardware scan above (crypttab likely wasn't
  # populated yet when nixos-generate-config ran) — carried over by hand
  # from the installer's configuration.nix. Without it, the swap LUKS
  # volume referenced above never gets unlocked at boot.
  boot.initrd.luks.devices."luks-19e72072-914f-45f8-a900-269c39889a6a".device =
    "/dev/disk/by-uuid/19e72072-914f-45f8-a900-269c39889a6a";

  nixpkgs.hostPlatform = lib.mkDefault "aarch64-linux";
}
